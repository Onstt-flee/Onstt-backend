# Copy to ~/.config/stt-api/judgment-pi5.env and chmod 600.
# Replace every CHANGE_ME value before starting a service.
JUDGMENT_ENABLED=true
JUDGMENT_SHADOW_ENABLED=false
JUDGMENT_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
JUDGMENT_MODEL=judgment-v02d
JUDGMENT_ADAPTER=judgment-qwen3-4b-failure-focus-v0.2-d-q4_k_m
JUDGMENT_TIMEOUT_SECONDS=120
JUDGMENT_MAX_CONCURRENCY=1
JUDGMENT_QUEUE_TIMEOUT_SECONDS=0
JUDGMENT_READINESS_TIMEOUT_SECONDS=5
JUDGMENT_SHUTDOWN_GRACE_SECONDS=30

EDGE_MODE=true
EDGE_NODE_ID=CHANGE_ME_UUID
EDGE_MODEL_SHA256=CHANGE_ME_64_HEX
EDGE_ADAPTER_SHA256=CHANGE_ME_64_HEX
EDGE_SYNC_ENDPOINT=https://CHANGE_ME_PRIVATE_GPU_HOST/edge/v1/sync
EDGE_SYNC_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

PI_MODEL_DIR=/mnt/nvme/judgment-models/qwen3-4b-v02d
PI_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
PI_ADAPTER_FILE=judgment-v0.2-d-f16.gguf
LLAMA_SERVER_BIN=%h/.local/bin/llama-server

