# Copy outside Git and replace every placeholder. Disabled by default.
FEEDBACK_AUDIT_ENABLED=false
FEEDBACK_ENDPOINT=http://127.0.0.1:1235/v1/chat/completions
FEEDBACK_MODEL=feedback-qwen3-8b-v01
FEEDBACK_ADAPTER=feedback-verifier-v0.1
FEEDBACK_MODEL_SHA256=REPLACE_WITH_COMBINED_DEPLOYMENT_ARTIFACT_SHA256
FEEDBACK_MAX_CONCURRENCY=1
FEEDBACK_TIMEOUT_SECONDS=120
FEEDBACK_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Required to attach immutable provenance to new GPU judgments.
JUDGMENT_MODEL_SHA256=REPLACE_WITH_BASE_MODEL_SHA256
JUDGMENT_ADAPTER_SHA256=REPLACE_WITH_V02D_ADAPTER_SHA256
