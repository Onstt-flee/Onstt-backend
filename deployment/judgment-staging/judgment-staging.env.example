# Copy to /etc/stt-api/judgment-staging.env with mode 0640.
# This repository example is intentionally disabled and must never be sourced
# as an approval to expose judgment results to learners.
JUDGMENT_ENABLED=false
JUDGMENT_SHADOW_ENABLED=false
JUDGMENT_SHADOW_QUEUE_MAX_SIZE=64
JUDGMENT_SHADOW_ITEM_TTL_SECONDS=30
JUDGMENT_SHADOW_ADMISSION_RPS=1
JUDGMENT_SHADOW_ADMISSION_BURST=1


JUDGMENT_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
JUDGMENT_MODEL=judgment-v02d
JUDGMENT_ADAPTER=judgment-qwen3-4b-failure-focus-v0.2-d
JUDGMENT_TIMEOUT_SECONDS=120
JUDGMENT_MAX_CONCURRENCY=2
JUDGMENT_QUEUE_TIMEOUT_SECONDS=0
JUDGMENT_READINESS_TIMEOUT_SECONDS=2
JUDGMENT_SHUTDOWN_GRACE_SECONDS=30
